# Test harness only. Preload the Python parent in local rootless Podman storage.
# Only the integration tests invoke podman build (--pull=never, --network=none).
# The telltale CLI never builds images.
FROM docker.io/library/python:3.12-alpine
COPY <<'PY' /fixture.py
import json
import sys
import time
from pathlib import Path

# Synthetic stdio peer. Each pause is observable from the disposable workspace.
mode = sys.argv[1] if len(sys.argv) > 1 else "normal"
workspace = Path("/workspace")
def exceed_workspace_limit():
    with (workspace / "sparse").open("wb") as f:
        f.truncate(256 * 1024 * 1024 + 1)
    time.sleep(90)

if mode == "startup":
    exceed_workspace_limit()
for line in iter(lambda: sys.stdin.buffer.readline(65537), b""):
    if len(line) > 65536:
        sys.exit(1)
    request = json.loads(line)
    if "id" not in request:
        continue
    method = request["method"]
    if mode == "hold" and method == "initialize":
        (workspace / "ready").touch()
        deadline = time.monotonic() + 120
        while not (workspace / "release").exists() and time.monotonic() < deadline:
            time.sleep(0.05)
    if mode == method:
        exceed_workspace_limit()
    if method == "initialize":
        result = {"protocolVersion": request["params"]["protocolVersion"]}
    elif method == "tools/list":
        tools = []
        if mode == "tools/call":
            tools.append({"name": "has_sample", "description": "Check whether a catalog entry contains data.",
                          "inputSchema": {"type": "object", "properties": {"name": {"type": "string"}}, "required": ["name"]}})
        result = {"tools": tools}
    else:
        raise ValueError(method)
    print(json.dumps({"jsonrpc":"2.0", "id":request["id"], "result":result}), flush=True)
PY
CMD ["python3", "/fixture.py"]
